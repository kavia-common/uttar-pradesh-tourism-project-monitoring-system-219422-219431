# You may not use this file except in compliance with the License.
# You may obtain a copy of the License at
#
#    http://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the License is distributed on an "AS IS" BASIS,
# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
# See the License for the specific language governing permissions and
# limitations under the License.
# ----------------------------------------------------------------------------

set -e

# resolve links - $0 may be a symlink
PRG="$0"

while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=$(dirname "$PRG")/"$link"
  fi
done

APP_BASE=$(cd "$(dirname "$PRG")" >/dev/null; pwd)

JAVA_HOME="${JAVA_HOME:-}"
MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$APP_BASE"}
WRAPPER_DIR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPERTIES="$WRAPPER_DIR/maven-wrapper.properties"
MVNW_VERBOSE="${MVNW_VERBOSE:-false}"

# Find Java
if [ -z "$JAVA_HOME" ]; then
  JAVA_EXE=$(command -v java || true)
else
  JAVA_EXE="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVA_EXE" ]; then
  echo "Error: Java executable not found. Please install Java 17+ or set JAVA_HOME." >&2
  exit 1
fi

# Load wrapper properties
if [ ! -f "$WRAPPER_PROPERTIES" ]; then
  echo "Error: $WRAPPER_PROPERTIES not found. Please make sure the Maven Wrapper is configured." >&2
  echo "You can regenerate it by running: mvn -N wrapper" >&2
  exit 1
fi

# Read distribution and wrapper URLs
distributionUrl=$(grep -E '^distributionUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
wrapperUrl=$(grep -E '^wrapperUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)

# Prepare wrapper jar
if [ ! -f "$WRAPPER_JAR" ]; then
  if [ "$MVNW_VERBOSE" = "true" ]; then
    echo "Downloading Maven Wrapper JAR from: $wrapperUrl"
  fi
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_JAR" "$wrapperUrl"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$WRAPPER_JAR" "$wrapperUrl"
  else
    echo "Error: curl or wget required to download Maven Wrapper JAR." >&2
    exit 1
  fi
fi

# Set JVM options
MAVEN_OPTS="${MAVEN_OPTS:-}"

# Execute Maven Wrapper
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

# Build classpath
CLASSPATH="$WRAPPER_JAR"

# Pass through args
exec "$JAVA_EXE" $MAVEN_OPTS -classpath "$CLASSPATH" "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" $WRAPPER_LAUNCHER "$@"
